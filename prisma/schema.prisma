// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------
// User & Auth Models
// ----------------------
model User {
  id                        String                     @id @default(uuid()) @db.Uuid
  mobile                    String                     @unique
  name                      String?
  lastName                  String?
  nationalCode              String?                    @unique
  password                  String? // Optional because initial login might be OTP only
  job                       String?
  addresses                 Json?                      @db.JsonB
  role                      Role                       @default(USER)
  permissions               String[]                   @default([])
  hashedRefreshToken        String? // For Refresh Token mechanism
  reviews                   ProductReview[]
  orders                    Order[]
  orderComments             OrderComment[]
  tempBaskets               TempBasket[]
  shoppingList              ShoppingListItem[]
  discountCodes             DiscountCode[]
  discountCodeEligibilities DiscountCodeEligibleUser[]
  customerGroupMemberships  CustomerGroupMember[]
  segmentMemberships        SegmentMembership[]
  incentiveRedemptions      IncentiveRedemption[]
  wallet                    Wallet?
  directConversation        DirectConversation?
  directMessages            DirectMessage[]            @relation("DirectMessageAuthor")
  offlineSales              OfflineSale[]
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  isDeleted                 Boolean                    @default(false)
  deletedAt                 DateTime?
}

model Otp {
  id        String   @id @default(uuid()) @db.Uuid
  mobile    String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

enum Role {
  USER
  ADMIN
  OPERATOR
}

// ----------------------
// Discount codes (کدهای تخفیف)
// ----------------------

enum DiscountCodeScope {
  ALL_USERS // همه کاربران
  SINGLE_USER // یک کاربر مشخص (userId)
  MULTIPLE_USERS // چند کاربر مشخص (جدول واسط)
  USER_GROUP // دسته کاربران (userGroupId — منطق بیزینس بعداً)
}

enum DiscountValueType {
  PERCENT // درصد تخفیف روی سبد
  FIXED_AMOUNT // مبلغ ثابت تخفیف (تومان)
}

model DiscountCode {
  id    String  @id @default(uuid()) @db.Uuid
  /// کد یکتا (معمولاً uppercase)
  code  String  @unique
  title String?

  scope       DiscountCodeScope
  /// وقتی scope = SINGLE_USER
  userId      String?           @db.Uuid
  user        User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// وقتی scope = USER_GROUP
  userGroupId String?           @db.Uuid
  userGroup   CustomerGroup?    @relation(fields: [userGroupId], references: [id], onDelete: SetNull)

  /// وقتی scope = MULTIPLE_USERS
  eligibleUsers DiscountCodeEligibleUser[]

  valueType      DiscountValueType
  /// درصد (۱–۱۰۰) یا مبلغ ثابت بسته به valueType
  value          Decimal           @db.Decimal(12, 2)
  minOrderAmount Decimal?          @db.Decimal(12, 2)

  validFrom DateTime
  validTo   DateTime

  /// حداکثر دفعات استفاده در کل (null = نامحدود)
  maxTotalUses Int?
  usedCount    Int  @default(0)

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  @@index([code])
  @@index([scope])
  @@index([validFrom, validTo])
  @@index([userId])
  @@index([userGroupId])
}

/// کاربرانی که برای کد با scope = MULTIPLE_USERS مجاز به استفاده هستند
model DiscountCodeEligibleUser {
  id             String       @id @default(uuid()) @db.Uuid
  discountCodeId String       @db.Uuid
  discountCode   DiscountCode @relation(fields: [discountCodeId], references: [id], onDelete: Cascade)
  userId         String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([discountCodeId, userId])
  @@index([userId])
}

/// دسته‌بندی دستی مشتریان (مثلاً «مشتریان وفادار»، «مشتریان از دست رفته») برای هدف‌گیری کمپین‌های مارکتینگ
model CustomerGroup {
  id            String                @id @default(uuid()) @db.Uuid
  title         String
  description   String?
  members       CustomerGroupMember[]
  discountCodes DiscountCode[]

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  @@index([isActive])
}

model CustomerGroupMember {
  id              String        @id @default(uuid()) @db.Uuid
  customerGroupId String        @db.Uuid
  customerGroup   CustomerGroup @relation(fields: [customerGroupId], references: [id], onDelete: Cascade)
  userId          String        @db.Uuid
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  addedAt         DateTime      @default(now())

  @@unique([customerGroupId, userId])
  @@index([userId])
}

// ----------------------
// E-commerce Models
// ----------------------

model Category {
  id          String     @id @default(uuid()) @db.Uuid
  title       String
  slug        String     @unique
  description String?
  image       String? // URL from MinIO
  parentId    String?    @db.Uuid
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]

  // کدگذاری محصولات این دسته‌بندی
  codeStart        Int // شروع بازهٔ کد این دسته‌بندی (مثلاً ۲۰۰) — ادمین تعیین می‌کند
  nextCode         Int // شمارندهٔ داخلی برای تخصیص خودکار کد به محصول بعدی
  profitMultiplier Decimal @default(1) @db.Decimal(6, 2) // ضریب سود این دسته‌بندی برای فرمول قیمت‌گذاری

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
}

model Collection {
  id          String    @id @default(uuid()) @db.Uuid
  title       String
  slug        String    @unique
  description String?
  image       String? // URL from MinIO
  products    Product[]
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
}

// سایزهای قابل انتخاب در واریانت محصول (مدیریت از پنل ادمین)
model Size {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique // مثلاً 42, XL, M
  order     Int       @default(0) // ترتیب نمایش
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
}

model ShippingMethod {
  id          String    @id @default(uuid()) @db.Uuid
  title       String
  description String?
  price       Int?
  isActive    Boolean   @default(true)
  orders      Order[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
}

model DirectConversation {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @unique @db.Uuid
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userLastReadAt  DateTime?
  adminLastReadAt DateTime?
  messages        DirectMessage[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  isDeleted       Boolean         @default(false)
  deletedAt       DateTime?
}

enum DirectAttachmentType {
  IMAGE
  AUDIO
}

model DirectMessage {
  id             String                @id @default(uuid()) @db.Uuid
  conversationId String                @db.Uuid
  conversation   DirectConversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorRole     Role
  authorUserId   String?               @db.Uuid
  authorUser     User?                 @relation("DirectMessageAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  text           String?
  attachmentType DirectAttachmentType?
  attachmentUrl  String?
  createdAt      DateTime              @default(now())
  isDeleted      Boolean               @default(false)
  deletedAt      DateTime?

  @@index([conversationId, createdAt])
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
}

model BlogCategory {
  id          String     @id @default(uuid()) @db.Uuid
  title       String
  slug        String     @unique
  description String?
  posts       BlogPost[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  isDeleted   Boolean    @default(false)
  deletedAt   DateTime?

  @@index([isDeleted, createdAt])
}

model BlogPost {
  id          String         @id @default(uuid()) @db.Uuid
  categoryId  String         @db.Uuid
  category    BlogCategory   @relation(fields: [categoryId], references: [id])
  status      BlogPostStatus @default(DRAFT)
  publishedAt DateTime?

  title   String
  slug    String  @unique
  excerpt String?
  content String

  coverImageUrl String?
  coverImageAlt String?

  seoTitle       String?
  seoDescription String?
  seoKeywords    String[]
  canonicalUrl   String?
  ogTitle        String?
  ogDescription  String?
  ogImageUrl     String?
  robotsNoIndex  Boolean  @default(false)
  robotsNoFollow Boolean  @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  @@index([categoryId])
  @@index([status, publishedAt])
  @@index([isDeleted, createdAt])
}

// Dynamic Specifications (e.g., Fabric, Care, Origin)
model SpecificationKey {
  id        String    @id @default(uuid()) @db.Uuid
  key       String    @unique // e.g. "material", "care_instruction"
  label     String // e.g. "جنس پارچه", "نحوه شستشو"
  type      SpecType  @default(TEXT)
  options   String[] // For SELECT type
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
}

enum SpecType {
  TEXT
  NUMBER
  SELECT
  MULTI_SELECT
}

model Product {
  id          String @id @default(uuid()) @db.Uuid
  title       String
  slug        String @unique
  description String

  // SEO
  metaTitle       String?
  metaDescription String?

  // Media (General product images/video)
  images String[] // URLs stored as array of strings
  video  String? // URL

  // Relations
  categoryId  String       @db.Uuid
  category    Category     @relation(fields: [categoryId], references: [id])
  collections Collection[]

  // کدگذاری و قیمت‌گذاری (سطح محصول، نه واریانت)
  code            Int      @unique // کد خودکار محصول (بر اساس بازهٔ کد دسته‌بندی)
  costPrice       Decimal  @db.Decimal(12, 2) // بهای تمام‌شدهٔ خالص (ورودی ادمین)
  finalPrice      Decimal  @db.Decimal(12, 2) // قیمت نهایی محاسبه‌شده از فرمول
  discountPrice   Decimal? @db.Decimal(12, 2) // تخفیف دستی روی finalPrice (اختیاری)
  discountPercent Int? // درصد تخفیف دستی (اختیاری)

  // Specifications (JSON with validation against SpecificationKey)
  // Format: { "material": "Cotton", "care": "Hand wash" }
  specifications Json?

  // Stats
  soldCount     Int   @default(0)
  viewCount     Int   @default(0)
  averageRating Float @default(0)
  reviewCount   Int   @default(0)

  // Variants (Size/Color)
  variants ProductVariant[]

  // Social
  reviews                ProductReview[]
  shoppingListItems      ShoppingListItem[]
  orderItems             OrderItem[]
  offlineSaleItems       OfflineSaleItem[]
  contentCalendarEntries ContentCalendarEntry[]
  contentPostedAt        DateTime? // اولین باری که این محصول توی شبکه‌های اجتماعی پست شد

  isActive    Boolean   @default(true)
  isFeatured  Boolean   @default(false) // محصول منتخب
  showInIntro Boolean   @default(false) // نمایش در اینترو
  showInRack  Boolean   @default(false) // نمایش در رگال دسته‌بندی (حداکثر ۷ محصول به ازای هر دسته‌بندی)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?

  // آخرین باری که به دلیل صفر شدن موجودی، پیامک اطلاع‌رسانی برای مدیر ارسال شد.
  // با برگشتن موجودی به حالت مثبت، دوباره null می‌شود تا دفعهٔ بعد که ناموجود شد هشدار تازه بره.
  outOfStockNotifiedAt DateTime?
}

enum ContentEntryType {
  POST
  STORY
}

model ContentCalendarEntry {
  id       String           @id @default(uuid()) @db.Uuid
  date     DateTime         @db.Date
  type     ContentEntryType
  title    String? // عنوان محتوا؛ برای آیتم خودکار (محصول‌محور) خالی می‌مونه
  products Product[] // می‌تونه خالی باشه

  isDone Boolean   @default(false)
  doneAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  @@index([date])
}

model ProductVariant {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  sku String @unique

  // Attributes
  size      String?
  color     String?
  colorCode String? // Hex code for color

  // Inventory (قیمت‌گذاری در سطح محصول است، نه واریانت — ر.ک. Product.finalPrice)
  stock Int @default(0)

  // Media specific to variant (e.g. Red shirt image)
  images String[]

  // Variant specific specifications (e.g. Waist size for this size)
  specifications Json?

  tempBasketItems  TempBasketItem[]
  orderItems       OrderItem[]
  offlineSaleItems OfflineSaleItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
}

model ProductReview {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id])
  userId    String  @db.Uuid
  user      User    @relation(fields: [userId], references: [id])

  rating  Int // 1-5
  comment String?

  isApproved Boolean @default(false) // Admin approval

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
}

model TempBasket {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     TempBasketItem[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  isDeleted Boolean          @default(false)
  deletedAt DateTime?

  @@index([userId])
  @@index([userId, isDeleted])
}

model TempBasketItem {
  id               String         @id @default(uuid()) @db.Uuid
  basketId         String         @db.Uuid
  basket           TempBasket     @relation(fields: [basketId], references: [id], onDelete: Cascade)
  productVariantId String         @db.Uuid
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  quantity         Int
  reservedUntil    DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  isDeleted        Boolean        @default(false)
  deletedAt        DateTime?

  @@unique([basketId, productVariantId])
  @@index([basketId])
  @@index([productVariantId])
}

// User shopping list (لیست خرید) — separate from cart, persisted per user
model ShoppingListItem {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String   @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

// نظرات کلی برند (تستیمونیال صفحه اصلی) — بدون وابستگی به محصول
model SiteTestimonial {
  id         String    @id @default(uuid()) @db.Uuid
  authorName String // نام نمایشی نویسنده نظر
  comment    String // متن نظر
  rating     Int? // 1-5 اختیاری
  isApproved Boolean   @default(false)
  order      Int       @default(0) // ترتیب نمایش (عدد کمتر = اول)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  isDeleted  Boolean   @default(false)
  deletedAt  DateTime?
}

model OrderNotificationPhone {
  id          String    @id @default(uuid()) @db.Uuid
  phoneNumber String    @unique
  label       String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
}

model SiteSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Placeholder for Order
enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum PaymentProvider {
  ZARINPAL
  ZIBAL
}

enum PaymentTransactionStatus {
  INITIATED
  PAID
  FAILED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELED
}

model Order {
  id                   String                @id @default(uuid()) @db.Uuid
  orderCode            String                @unique
  userId               String                @db.Uuid
  user                 User                  @relation(fields: [userId], references: [id])
  items                OrderItem[]
  comments             OrderComment[]
  totalAmount          Decimal               @default(0) @db.Decimal(10, 2)
  discountCode         String?
  discountAmount       Decimal               @default(0) @db.Decimal(10, 2)
  packagingCost        Decimal               @default(0) @db.Decimal(10, 2)
  shippingCost         Decimal               @default(0) @db.Decimal(10, 2)
  shippingMethodId     String?               @db.Uuid
  shippingMethod       ShippingMethod?       @relation(fields: [shippingMethodId], references: [id], onDelete: SetNull)
  shippingMethodTitle  String?
  shippingMethodPrice  Int?
  payableAmount        Decimal               @default(0) @db.Decimal(10, 2)
  shippingAddress      Json?                 @db.JsonB
  paymentStatus        PaymentStatus         @default(PENDING)
  orderStatus          OrderStatus           @default(PENDING_PAYMENT)
  paidAt               DateTime?
  payments             PaymentTransaction[]
  incentiveRedemptions IncentiveRedemption[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  isDeleted            Boolean               @default(false)
  deletedAt            DateTime?

  @@index([shippingMethodId])
  @@index([paidAt])
  @@index([paymentStatus, paidAt])
  @@index([orderStatus, paidAt])
  @@index([createdAt])
}

model OrderComment {
  id           String         @id @default(uuid()) @db.Uuid
  orderId      String         @db.Uuid
  order        Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  authorRole   Role
  authorUserId String?        @db.Uuid
  authorUser   User?          @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  parentId     String?        @db.Uuid
  parent       OrderComment?  @relation("OrderCommentToParent", fields: [parentId], references: [id], onDelete: Cascade)
  replies      OrderComment[] @relation("OrderCommentToParent")
  message      String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  isDeleted    Boolean        @default(false)
  deletedAt    DateTime?

  @@index([orderId])
  @@index([authorUserId])
  @@index([parentId])
}

model PaymentTransaction {
  id         String                   @id @default(uuid()) @db.Uuid
  orderId    String                   @db.Uuid
  order      Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider   PaymentProvider
  status     PaymentTransactionStatus @default(INITIATED)
  amount     Decimal                  @db.Decimal(10, 2)
  authority  String?                  @unique
  refId      String?
  createdAt  DateTime                 @default(now())
  verifiedAt DateTime?
  isDeleted  Boolean                  @default(false)
  deletedAt  DateTime?

  @@index([orderId])
  @@index([provider])
  @@index([status])
}

model OrderItem {
  id                String         @id @default(uuid()) @db.Uuid
  orderId           String         @db.Uuid
  order             Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String         @db.Uuid
  product           Product        @relation(fields: [productId], references: [id])
  productVariantId  String         @db.Uuid
  productVariant    ProductVariant @relation(fields: [productVariantId], references: [id])
  sku               String
  title             String
  quantity          Int
  unitPrice         Decimal        @db.Decimal(10, 2)
  unitDiscountPrice Decimal?       @db.Decimal(10, 2)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  isDeleted         Boolean        @default(false)
  deletedAt         DateTime?

  @@index([orderId])
  @@index([productId])
  @@index([productVariantId])
}

// ----------------------
// Offline / manual sales (Instagram, in-person, events)
// ----------------------

model OfflineSale {
  id                String            @id @default(uuid()) @db.Uuid
  channel           String // متن آزاد: "اینستاگرام"، "ایونت تجریش"، "حضوری فروشگاه"...
  commissionPercent Decimal?          @db.Decimal(5, 2) // درصد کمیسیون مکان فروش (اختیاری)
  discountAmount    Decimal           @default(0) @db.Decimal(12, 2)
  totalAmount       Decimal           @default(0) @db.Decimal(12, 2) // مجموع قبل از تخفیف
  commissionAmount  Decimal           @default(0) @db.Decimal(12, 2)
  payableAmount     Decimal           @default(0) @db.Decimal(12, 2) // بعد از تخفیف
  netAmount         Decimal           @default(0) @db.Decimal(12, 2) // بعد از تخفیف و کمیسیون
  costOfGoods       Decimal           @default(0) @db.Decimal(12, 2) // اسنپ‌شات بهای تمام‌شده
  note              String?
  soldAt            DateTime          @default(now())
  createdByUserId   String?           @db.Uuid
  createdByUser     User?             @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  items             OfflineSaleItem[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  isDeleted         Boolean           @default(false)
  deletedAt         DateTime?

  @@index([isDeleted, soldAt])
}

model OfflineSaleItem {
  id               String         @id @default(uuid()) @db.Uuid
  offlineSaleId    String         @db.Uuid
  offlineSale      OfflineSale    @relation(fields: [offlineSaleId], references: [id], onDelete: Cascade)
  productId        String         @db.Uuid
  product          Product        @relation(fields: [productId], references: [id])
  productVariantId String         @db.Uuid
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  sku              String
  title            String
  quantity         Int
  unitPrice        Decimal        @db.Decimal(12, 2)
  unitCostPrice    Decimal        @db.Decimal(12, 2) // اسنپ‌شات Product.costPrice در لحظه فروش
  createdAt        DateTime       @default(now())

  @@index([offlineSaleId])
  @@index([productId])
  @@index([productVariantId])
}

// ----------------------
// Customer Loyalty Club
// ----------------------

model CustomerSegment {
  id          String   @id @default(uuid()) @db.Uuid
  /// شناسه پایدار برای رفرنس دادن از کد (مثلاً "vip"، "at_risk")
  key         String   @unique
  label       String
  description String?
  createdAt   DateTime @default(now())

  memberships SegmentMembership[]
  incentives  Incentive[]
}

/// تاریخچهٔ عضویت مشتری در سگمنت‌ها — سری زمانی، هر بار محاسبه یک رکورد جدید (نه یکتا به‌ازای مشتری)
model SegmentMembership {
  id             String          @id @default(uuid()) @db.Uuid
  customerId     String          @db.Uuid
  customer       User            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  segmentId      String          @db.Uuid
  segment        CustomerSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  recencyDays    Int
  frequencyCount Int
  monetaryTotal  Decimal         @db.Decimal(12, 2)
  computedAt     DateTime        @default(now())

  @@index([customerId])
  @@index([segmentId])
  @@index([computedAt])
}

enum IncentiveType {
  DISCOUNT_CODE
  CASHBACK
  COUPON
  CREDIT_GIFT
  POINTS_BADGE
}

enum IncentiveValueType {
  PERCENTAGE
  FIXED_AMOUNT
}

/// جدول پایه با الگوی discriminator — جزئیات هر نوع در جدول ۱:۱ مخصوص خودش
model Incentive {
  id              String           @id @default(uuid()) @db.Uuid
  type            IncentiveType
  title           String
  /// null = برای همه مشتریان
  targetSegmentId String?          @db.Uuid
  targetSegment   CustomerSegment? @relation(fields: [targetSegmentId], references: [id], onDelete: SetNull)
  isActive        Boolean          @default(true)
  startsAt        DateTime
  endsAt          DateTime
  createdAt       DateTime         @default(now())

  discountCodeDetail DiscountCodeDetail?
  cashbackDetail     CashbackDetail?
  couponDetail       CouponDetail?
  creditGiftDetail   CreditGiftDetail?
  pointsBadgeDetail  PointsBadgeDetail?
  redemptions        IncentiveRedemption[]

  @@index([type])
  @@index([targetSegmentId])
  @@index([isActive, startsAt, endsAt])
}

enum IncentiveTierType {
  FLAT
  STEPPED
  /// پلکانی بر اساس امین بار استفادهٔ همان مشتری از این کد (نه مبلغ سفارش) — کد ۳ باره ۱۰٪/۱۵٪/۲۰٪
  USAGE_STEPPED
}

enum IncentiveUsageType {
  SINGLE_USE
  MULTI_USE
}

/// جزئیات وقتی Incentive.type = DISCOUNT_CODE
model DiscountCodeDetail {
  incentiveId       String             @id @db.Uuid
  incentive         Incentive          @relation(fields: [incentiveId], references: [id], onDelete: Cascade)
  code              String             @unique
  valueType         IncentiveValueType
  /// وقتی tierType = FLAT، مقدار تخفیف همین است (پله‌ای در کار نیست)
  value             Decimal            @db.Decimal(12, 2)
  tierType          IncentiveTierType  @default(FLAT)
  usageType         IncentiveUsageType @default(SINGLE_USE)
  minPurchaseAmount Decimal?           @db.Decimal(12, 2)
  /// وقتی tierType = STEPPED — لیست پله‌ها بر اساس حداقل مبلغ سفارش
  tiers             DiscountCodeTier[]
}

/// یک پلهٔ تخفیف پلکانی. برای tierType=STEPPED با minAmount (بالاترین پله‌ای که
/// minAmount آن <= مبلغ سفارش باشد اعمال می‌شود). برای tierType=USAGE_STEPPED با
/// usageIndex (امین بار استفادهٔ مشتری از کد — ۱=اولین بار).
model DiscountCodeTier {
  id                   String             @id @default(uuid()) @db.Uuid
  discountCodeDetailId String             @db.Uuid
  discountCodeDetail   DiscountCodeDetail @relation(fields: [discountCodeDetailId], references: [incentiveId], onDelete: Cascade)
  minAmount            Decimal?           @db.Decimal(12, 2)
  /// وقتی tierType = USAGE_STEPPED — امین بار استفادهٔ مشتری (۱، ۲، ۳، ...)
  usageIndex           Int?
  /// درصد یا مبلغ ثابت، بسته به valueType والد (DiscountCodeDetail.valueType)
  value                Decimal            @db.Decimal(12, 2)

  @@index([discountCodeDetailId])
}

/// جزئیات وقتی Incentive.type = CASHBACK
model CashbackDetail {
  incentiveId       String             @id @db.Uuid
  incentive         Incentive          @relation(fields: [incentiveId], references: [id], onDelete: Cascade)
  valueType         IncentiveValueType
  value             Decimal            @db.Decimal(12, 2)
  expiresAfterDays  Int?
  minPurchaseAmount Decimal?           @db.Decimal(12, 2)
}

enum CouponTriggerType {
  FIRST_PURCHASE
  PURCHASE_ABOVE_AMOUNT
  REFERRAL
  CATEGORY_PURCHASE
}

/// جزئیات وقتی Incentive.type = COUPON
model CouponDetail {
  incentiveId       String             @id @db.Uuid
  incentive         Incentive          @relation(fields: [incentiveId], references: [id], onDelete: Cascade)
  triggerType       CouponTriggerType
  /// پیکربندی محرک (مثلاً { "categoryId": "..." } یا { "minAmount": 500000 })
  triggerConfig     Json
  rewardDescription String
  /// درصد یا مبلغ ثابت پاداش — درصد فقط وقتی سفارش محرک وجود دارد قابل‌محاسبه است (نه در REFERRAL بدون سفارش)
  rewardValueType   IncentiveValueType
  rewardValue       Decimal            @db.Decimal(12, 2)
}

/// جزئیات وقتی Incentive.type = CREDIT_GIFT — واریز اعتبار به کیف‌پول مشتری پس از ریدیم
model CreditGiftDetail {
  incentiveId       String    @id @db.Uuid
  incentive         Incentive @relation(fields: [incentiveId], references: [id], onDelete: Cascade)
  amount            Decimal   @db.Decimal(12, 2)
  /// null = بدون انقضا
  expiresAfterDays  Int?
  minPurchaseAmount Decimal?  @db.Decimal(12, 2)
}

/// جزئیات وقتی Incentive.type = POINTS_BADGE — می‌تواند فقط امتیاز، فقط نشان، یا هر دو باشد
model PointsBadgeDetail {
  incentiveId   String    @id @db.Uuid
  incentive     Incentive @relation(fields: [incentiveId], references: [id], onDelete: Cascade)
  pointsAwarded Int
  badgeKey      String?
  badgeLabel    String?
}

model IncentiveRedemption {
  id            String    @id @default(uuid()) @db.Uuid
  incentiveId   String    @db.Uuid
  incentive     Incentive @relation(fields: [incentiveId], references: [id], onDelete: Cascade)
  customerId    String    @db.Uuid
  customer      User      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderId       String?   @db.Uuid
  order         Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  redeemedAt    DateTime  @default(now())
  amountApplied Decimal   @db.Decimal(12, 2)

  creditLedgerEntry CreditLedgerEntry?

  @@index([incentiveId])
  @@index([customerId])
  @@index([orderId])
}

/// کیف‌پول اعتباری مشتری — موجودی فعلی؛ تاریخچهٔ تراکنش‌ها در CreditLedgerEntry
model Wallet {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Decimal  @default(0) @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ledgerEntries CreditLedgerEntry[]
}

enum CreditLedgerReason {
  GIFT
  CASHBACK
  COUPON
  USED
  EXPIRED
  ADJUSTMENT
}

model CreditLedgerEntry {
  id                    String               @id @default(uuid()) @db.Uuid
  walletId              String               @db.Uuid
  wallet                Wallet               @relation(fields: [walletId], references: [id], onDelete: Cascade)
  /// مثبت = واریز، منفی = برداشت/انقضا
  amount                Decimal              @db.Decimal(12, 2)
  reason                CreditLedgerReason
  /// وقتی reason = GIFT — ریدیمی که این واریز از آن ایجاد شده
  incentiveRedemptionId String?              @unique @db.Uuid
  incentiveRedemption   IncentiveRedemption? @relation(fields: [incentiveRedemptionId], references: [id], onDelete: SetNull)
  expiresAt             DateTime?
  createdAt             DateTime             @default(now())

  @@index([walletId])
}

model ChurnEvaluationSnapshot {
  id               String   @id @default(uuid()) @db.Uuid
  computedAt       DateTime @default(now())
  totalCustomers   Int
  atRiskCount      Int
  lostCount        Int
  regularCount     Int
  churnRatePercent Decimal  @db.Decimal(5, 2)

  @@index([computedAt])
}

model LoyaltyEvaluationSnapshot {
  id                 String   @id @default(uuid()) @db.Uuid
  computedAt         DateTime @default(now())
  totalCustomers     Int
  loyalCount         Int
  promisingCount     Int
  regularCount       Int
  loyaltyRatePercent Decimal  @db.Decimal(5, 2)

  @@index([computedAt])
}
